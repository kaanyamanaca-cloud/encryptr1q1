-- Roblox BoneESP Bağlantıları (R6 / R15 Otomatik Ayrıştırma)
local function GetBonePairs(character)
    if character:FindFirstChild("UpperTorso") then -- R15
        return {
            { "Head", "UpperTorso" },
            { "UpperTorso", "LowerTorso" },
            { "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" }, { "LeftLowerArm", "LeftHand" },
            { "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
            { "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" }, { "LeftLowerLeg", "LeftFoot" },
            { "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" }
        }
    elseif character:FindFirstChild("Torso") then -- R6
        return {
            { "Head", "Torso" },
            { "Torso", "Left Arm" },
            { "Torso", "Right Arm" },
            { "Torso", "Left Leg" },
            { "Torso", "Right Leg" }
        }
    end
    return {}
end

-- ESP Çizim Deposu
local ESPStorage = {}

local function ClearESP(player)
    if ESPStorage[player] then
        for _, drawing in pairs(ESPStorage[player]) do
            pcall(function() drawing:Remove() end)
        }
        ESPStorage[player] = nil
    end
end

Players.PlayerRemoving:Connect(ClearESP)

local function RenderESP()
    if not Settings.ESP.Enabled then
        for player, _ in pairs(ESPStorage) do ClearESP(player) end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") and char.Humanoid.Health > 0 then
                local hrp = char.HumanoidRootPart
                local distance = (hrp.Position - Camera.CFrame.Position).Magnitude

                if distance <= Settings.ESP.MaxDistance then
                    local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        if not ESPStorage[player] then
                            ESPStorage[player] = {
                                Box = Drawing.new("Square"),
                                Name = Drawing.new("Text"),
                                Bones = {}
                            }
                            ESPStorage[player].Box.Visible = false
                            ESPStorage[player].Box.Filled = false
                            ESPStorage[player].Box.Thickness = 1
                            ESPStorage[player].Name.Visible = false
                            ESPStorage[player].Name.Size = 13
                            ESPStorage[player].Name.Center = true
                            ESPStorage[player].Name.Outline = true
                            ESPStorage[player].Name.Color = Color3.new(1, 1, 1)
                        end

                        local esp = ESPStorage[player]
                        local scale = 2500 / pos.Z
                        local width, height = 1.5 * scale, 2 * scale
                        local topLeft = Vector2.new(pos.X - width / 2, pos.Y - height / 2)

                        -- Kutu Çizimi
                        if Settings.ESP.Box then
                            esp.Box.Visible = true
                            esp.Box.Position = topLeft
                            esp.Box.Size = Vector2.new(width, height)
                            esp.Box.Color = Settings.ESP.BoxColor
                        else
                            esp.Box.Visible = false
                        end

                        -- İsim ve Mesafe Çizimi
                        if Settings.ESP.Name then
                            esp.Name.Visible = true
                            esp.Name.Position = Vector2.new(pos.X, topLeft.Y - 16)
                            esp.Name.Text = string.format("%s [%dm]", player.Name, math.floor(distance))
                        else
                            esp.Name.Visible = false
                        end

                        -- Bone ESP Çizimi
                        if Settings.ESP.BoneESP then
                            local bonePairs = GetBonePairs(char)
                            for i, pair in ipairs(bonePairs) do
                                local p1Part = char:FindFirstChild(pair[1])
                                local p2Part = char:FindFirstChild(pair[2])
                                if p1Part and p2Part then
                                    local p1Screen, p1On = Camera:WorldToViewportPoint(p1Part.Position)
                                    local p2Screen, p2On = Camera:WorldToViewportPoint(p2Part.Position)
                                    if p1On and p2On then
                                        if not esp.Bones[i] then
                                            esp.Bones[i] = Drawing.new("Line")
                                            esp.Bones[i].Thickness = 1
                                        end
                                        esp.Bones[i].Visible = true
                                        esp.Bones[i].From = Vector2.new(p1Screen.X, p1Screen.Y)
                                        esp.Bones.To = Vector2.new(p2Screen.X, p2Screen.Y)
                                        esp.Bones[i].Color = Settings.ESP.BoneColor
                                    elseif esp.Bones[i] then
                                        esp.Bones[i].Visible = false
                                    end
                                end
                            end
                        else
                            for _, line in pairs(esp.Bones) do line.Visible = false end
                        end
                    else
                        ClearESP(player)
                    end
                else
                    ClearESP(player)
                end
            else
                ClearESP(player)
            end
        end
    end
end


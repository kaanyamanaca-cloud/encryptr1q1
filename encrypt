-- Hedef Bulma ve Aimbot Mantığı
local function GetBestTarget()
    local bestTarget = nil
    local shortestDistance = Settings.Aimbot.FOV

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            if not Settings.Triggerbot.TeamCheck or player.Team ~= LocalPlayer.Team then
                local hitboxPart = player.Character:FindFirstChild(Settings.Aimbot.Hitbox) or player.Character:FindFirstChild("HumanoidRootPart")
                if hitboxPart then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(hitboxPart.Position)
                    if onScreen then
                        local mousePos = UserInputService:GetMouseLocation()
                        local magnitude = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if magnitude < shortestDistance then
                            shortestDistance = magnitude
                            bestTarget = player.Character
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

local function RunAimbot(targetChar)
    if not Settings.Aimbot.Enabled then return end
    if targetChar and targetChar:FindFirstChild(Settings.Aimbot.Hitbox) then
        local targetPart = targetChar[Settings.Aimbot.Hitbox]
        local targetScreenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
        if onScreen then
            local mousePos = UserInputService:GetMouseLocation()
            local currentMousePos = Vector2.new(mousePos.X, mousePos.Y)
            local targetVector = Vector2.new(targetScreenPos.X, targetScreenPos.Y)
            
            -- Yumuşak geçiş (Smooth)
            local smoothed = currentMousePos + (targetVector - currentMousePos) / Settings.Aimbot.Smooth
            if mousemoverel then
                mousemoverel(smoothed.X - currentMousePos.X, smoothed.Y - currentMousePos.Y)
            end
        end
    end
end

-- Triggerbot Mantığı
local function RunTriggerbot()
    if not Settings.Triggerbot.Enabled then return end
    local mouseTarget = LocalPlayer:GetMouse().Target
    if mouseTarget and mouseTarget.Parent then
        local enemyPlayer = Players:GetPlayerFromCharacter(mouseTarget.Parent)
        if enemyPlayer and enemyPlayer ~= LocalPlayer then
            if not Settings.Triggerbot.TeamCheck or enemyPlayer.Team ~= LocalPlayer.Team then
                task.wait(Settings.Triggerbot.Delay)
                if mouse1click then
                    mouse1click()
                end
            end
        end
    end
end

